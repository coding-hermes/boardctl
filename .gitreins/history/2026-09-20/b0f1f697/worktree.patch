ooks right'.", "created_at": "2026-09-20T04:49:43Z", "updated_at": "2026-09-20T04:49:43Z", "worker_status": "pending", "detail": {"fingerprint": "4228fc623fb8fe5307fcbf9994be8de9a1cdede7bacac58b4a6a7db6a1ab98d0"}, "ts": null, "complexity": 3}
