 output is a page never outrank the lanes whose output is a fix.", "detail": {"fingerprint": "5e6b41e93ca8ef9d94cf33b73bcd0fff4bea12fb8c39725cec88fefb03d60ec0"}, "created_at": "2026-10-01T00:34:05Z", "created_by": null, "worker_status": "pending", "commit_hash": null, "guard_result": null, "ci_result": null, "capability_tags": ["boardctl", "priority", "paperwork", "default"], "complexity": 2, "updated_at": "2026-10-01T00:34:05Z", "worker_summary": null, "foreman_note": null, "completed_at": null, "worktree": null, "branch": null, "sessions": null, "depends_on": ["BT-070"]}
