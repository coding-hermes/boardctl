+// closeIDDupeLineLocked is CloseIDDupeLine's body, running under the write guard.
+func (b *Board) closeIDDupeLineLocked(line1 int) error {
+	lines, err := ReadJSONLLines(b.tasksPath)
+	if err != nil {
+		return err
+	}
