+	"allowEmptyValue": {},
+	"default":         {},
+	"deprecated":      {},
+	"description":     {},
+	"discriminator":   {},
+	"example":         {},
+	"examples":        {},
+	"externalDocs":    {},
+	"nullable":        {},
+	"readOnly":        {},
+	"title":           {},
+	"writeOnly":       {},
+	"xml":             {},
